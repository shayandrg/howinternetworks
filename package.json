{
  "name": "howinternetworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "serve .output/public -l 3000",
    "deploy": "nuxt generate && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "originality": "tsx scripts/check-originality.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^9",
    "jsdom": "^31.0.1",
    "nuxt": "^4.7.0",
    "serve": "^14.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0"
  }
}
